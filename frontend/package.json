{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:api": "node ../scripts/generate-api.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node ../scripts/e2e.mjs",
    "format:check": "prettier --check src/App.tsx src/App.test.tsx src/App.css src/index.css src/app src/features src/shared e2e ../scripts/demo.mjs ../scripts/demo.test.mjs",
    "format": "prettier --write src/App.tsx src/App.test.tsx src/App.css src/index.css src/app src/features src/shared e2e ../scripts/demo.mjs ../scripts/demo.test.mjs",
    "demo": "node ../scripts/demo.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@tanstack/react-query": "5.106.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "24.22.1",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2"
}
