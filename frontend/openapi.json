                  "items": {
                    "$ref": "#/components/schemas/Apartment"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "summary": "Lists all apartments.",
        "tags": [
          "Apartment"
        ]
      }
    },
