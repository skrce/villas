    "securitySchemes": {
      "staffSession": {
        "description": "HttpOnly, host-scoped session cookie. Local HTTP uses VILLAS_LOCAL_SESSION. Browser requests use same-origin credentials; never read or copy this cookie in JavaScript.",
        "in": "cookie",
        "name": "__Host-villas",
        "type": "apiKey"
      }
    }
