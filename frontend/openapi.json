        "properties": {
          "customerId": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "endDate": {
            "nullable": true,
            "type": "string"
          },
          "guestCount": {
            "format": "int32",
            "type": "integer"
          },
          "id": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "nights": {
            "format": "int64",
            "type": "integer"
          },
          "roomId": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "startDate": {
            "nullable": true,
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "CANCELLED"
            ],
            "type": "string"
          },
          "version": {
            "format": "int64",
            "type": "integer"
